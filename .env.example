# ---- Backend (backend/.env or Cloud Run env vars) -----------------------
# Run fully offline with in-memory Firestore/GCS and a deterministic mock Gemini:
MOCK_MODE=true
# DEMO_MODE enables the time-travel endpoint/control.
DEMO_MODE=true
# Auth: "firebase" verifies Firebase ID tokens; "mock" accepts "Bearer mock:<uid>" (local only).
AUTH_MODE=mock

# Real GCP mode (MOCK_MODE=false). Credentials come from ADC, never from keys in this repo.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=recoverai-511917
GOOGLE_CLOUD_LOCATION=asia-south1
# Region used only for the Gemini client (set to us-central1/global if models are not in asia-south1)
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
EVIDENCE_BUCKET=recoverai-511917-recoverai-evidence
ALLOWED_ORIGINS=https://recoverai-511917.web.app,https://recoverai-511917.firebaseapp.com
COPILOT_RUNTIME=cloudrun
# Offline only: build the synthetic transaction data at startup
SEED_ON_STARTUP=true

# F15 Pub/Sub event backbone. EVENT_BUS=pubsub in the cloud; "local" delivers push messages in-process (default in mock mode)
EVENT_BUS=
TOPIC_CASE_SUBMITTED=fraud-case-submitted
TOPIC_BANK_DECISION=bank-decision
# OIDC check on the push endpoints (deploy.sh sets these; audience = deterministic Cloud Run URL)
PUSH_AUDIENCE=https://recoverai-api-PROJECT_NUMBER.asia-south1.run.app
PUSH_SA_EMAIL=pubsub-push@recoverai-511917.iam.gserviceaccount.com

# F14 BigQuery. ANALYTICS_BACKEND=bigquery in the cloud; "local" = synthetic rows in-process (default in mock mode)
ANALYTICS_BACKEND=
BQ_DATASET=recoverai_analytics
BQ_LOCATION=asia-south1
# S2 (stretch): advisory BigQuery ML mule-risk score next to the rule score
ENABLE_ML_SCORE=true

# F16 Vertex AI Search serving config (deploy.sh search). Empty = local BM25 over knowledge/ (if present) or playbook text.
VERTEX_SEARCH_SERVING_CONFIG=
# KNOWLEDGE_DIR=../knowledge

# Deploy defaults (deploy/deploy.sh) — identifiers only, no secrets
# PROJECT_ID=recoverai-511917
# GCLOUD_ACCOUNT=alokkumar.iiitm@gmail.com
# REGION=asia-south1

# ---- Frontend (frontend/.env.local) -------------------------------------
# VITE_MOCK=true             # no Firebase: mock auth + polling instead of Firestore listeners
# VITE_API_BASE=             # empty = same origin (Firebase Hosting rewrite /api/** -> Cloud Run)
# VITE_CHAT_BASE=            # optional direct Cloud Run URL for SSE chat (avoids rewrite buffering)
# VITE_FIREBASE_API_KEY=...  # Firebase web config (public identifiers, written by deploy.sh)
# VITE_FIREBASE_AUTH_DOMAIN=...
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_APP_ID=...
# VITE_DEMO_MODE=true
