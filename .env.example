# ---- Backend (backend/.env or Cloud Run env vars) -----------------------
# Run fully offline with in-memory Firestore/GCS and a deterministic mock Gemini:
MOCK_MODE=true
# DEMO_MODE enables the time-travel endpoint/control.
DEMO_MODE=true
# Auth: "firebase" verifies Firebase ID tokens; "mock" accepts "Bearer mock:<uid>" (local only).
AUTH_MODE=mock

# Real GCP mode (MOCK_MODE=false). Credentials come from ADC, never from keys in this repo.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-south1
# Region used only for the Gemini client (set to us-central1/global if models are not in asia-south1)
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
EVIDENCE_BUCKET=your-project-id-recoverai-evidence
ALLOWED_ORIGINS=https://your-project-id.web.app,https://your-project-id.firebaseapp.com
# Shared token for the HTTP A2A inbox (generated by deploy.sh; leave empty to dispatch in-process only)
A2A_TOKEN=
COPILOT_RUNTIME=cloudrun
SEED_ON_STARTUP=true

# ---- Frontend (frontend/.env.local) -------------------------------------
# VITE_MOCK=true             # no Firebase: mock auth + polling instead of Firestore listeners
# VITE_API_BASE=             # empty = same origin (Firebase Hosting rewrite /api/** -> Cloud Run)
# VITE_CHAT_BASE=            # optional direct Cloud Run URL for SSE chat (avoids rewrite buffering)
# VITE_FIREBASE_API_KEY=...  # Firebase web config (public identifiers, written by deploy.sh)
# VITE_FIREBASE_AUTH_DOMAIN=...
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_APP_ID=...
# VITE_DEMO_MODE=true
