{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "recoverai-api", "region": "asia-south1" } },
      { "source": "/api/health", "run": { "serviceId": "recoverai-api", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**", "headers": [{ "key": "Permissions-Policy", "value": "microphone=(self), camera=(), geolocation=()" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "emulators": { "firestore": { "port": 8181 }, "ui": { "enabled": false }, "singleProjectMode": true }
}
